# ===================================================================
# ENTERPRISE HR SAAS - CENTRAL ENVIRONMENT CONFIGURATION EXAMPLE
# ===================================================================

# -------------------------------------------------------------------
# APPLICATION ENVIRONMENT & PROFILES
# -------------------------------------------------------------------
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev
NEXT_TELEMETRY_DISABLED=1

# -------------------------------------------------------------------
# SERVICE APPLICATION PORTS
# -------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# -------------------------------------------------------------------
# APPLICATION URLS & HOSTNAMES
# -------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:8080
BACKEND_DOCKER_API_URL=http://backend:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_VERSION=v1

# -------------------------------------------------------------------
# DATABASE CONFIGURATION (POSTGRESQL)
# -------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_DB=awais_hr_master
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/awais_hr_master
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root

# OBSERVABILITY & TENANT DATABASES
OBSERVABILITY_DATASOURCE_URL=jdbc:postgresql://postgres:5432/awais_hr_observability
OBSERVABILITY_DATASOURCE_USERNAME=postgres
OBSERVABILITY_DATASOURCE_PASSWORD=root
TENANT_DATASOURCE_URL_PREFIX=jdbc:postgresql://postgres:5432/
TENANT_DATASOURCE_USERNAME=postgres
TENANT_DATASOURCE_PASSWORD=root

# -------------------------------------------------------------------
# REDIS CACHE & SESSION STORE
# -------------------------------------------------------------------
