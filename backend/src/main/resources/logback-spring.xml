<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <!-- Clean, Simple Human-Readable Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %clr(%-5level) %clr([tenant:%X{tenantId:-system}]){cyan} %clr(%logger{30}){blue} - %msg%n%wEx</pattern>
        </encoder>
    </appender>

    <!-- Custom Observability Ring Buffer Appender for In-App Dashboard stream -->
    <appender name="OBSERVABILITY" class="com.awais.hr.module.observability.util.ObservabilityLogbackAppender" />

    <!-- Logger configurations: Silence SQL queries & verbose internal traces -->
    <logger name="com.awais.hr" level="INFO" />
    <logger name="org.springframework.web" level="INFO" />
    <logger name="org.springframework.security" level="WARN" />
    <logger name="org.hibernate" level="OFF" />
    <logger name="org.hibernate.SQL" level="OFF" />
    <logger name="org.hibernate.type.descriptor.sql" level="OFF" />
    <logger name="org.hibernate.stat" level="OFF" />

    <logger name="org.springframework.jdbc" level="WARN" />
    <logger name="org.flywaydb" level="INFO" />

    <!-- Root Logger: Clean Console only (No JSON/Grafana console blobs) -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="OBSERVABILITY" />
    </root>
</configuration>
