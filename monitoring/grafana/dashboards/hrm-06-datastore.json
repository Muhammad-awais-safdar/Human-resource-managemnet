{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "title": "HRM \u2014 Database & Redis",
  "uid": "hrm-datastore",
  "tags": ["hrm", "database", "postgresql", "redis"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "links": [{ "title": "Overview", "url": "/d/hrm-overview", "type": "link" }],

  "panels": [
    {
      "id": 1, "type": "row", "title": "POSTGRESQL",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false
    },
    {
      "id": 2, "title": "PostgreSQL UP",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "expr": "pg_up", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "name", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": { "defaults": { "mappings": [{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}], "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"green","value":1}] } } }
    },
    {
      "id": 3, "title": "Active Connections",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [{ "expr": "pg_stat_activity_count{state=\"active\"}", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":15},{"color":"red","value":25}] } } }
    },
    {
      "id": 4, "title": "Total Connections",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "expr": "sum(pg_stat_activity_count)", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":30},{"color":"red","value":80}] } } }
    },
    {
      "id": 5, "title": "DB Size",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "expr": "sum(pg_database_size_bytes{datname=~\"awais.*\"})", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [{"color":"blue","value":null}] } } }
    },
    {
      "id": 6, "title": "Cache Hit Ratio",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "expr": "(sum(pg_stat_database_blks_hit) / (sum(pg_stat_database_blks_hit) + sum(pg_stat_database_blks_read))) * 100", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"yellow","value":80},{"color":"green","value":95}] } } }
    },
    {
      "id": 7, "title": "Transactions/sec",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [{ "expr": "sum(rate(pg_stat_database_xact_commit[5m])) + sum(rate(pg_stat_database_xact_rollback[5m]))", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"color":"blue","value":null}] } } }
    },

    {
      "id": 10, "title": "PostgreSQL Connections Over Time",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        { "expr": "pg_stat_activity_count{state=\"active\"}", "legendFormat": "Active" },
        { "expr": "pg_stat_activity_count{state=\"idle\"}",   "legendFormat": "Idle" },
        { "expr": "sum(pg_stat_activity_count)",              "legendFormat": "Total" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } }
    },
    {
      "id": 11, "title": "Commit vs Rollback Rate",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_xact_commit[5m]))",   "legendFormat": "Commits/s" },
        { "expr": "sum(rate(pg_stat_database_xact_rollback[5m]))", "legendFormat": "Rollbacks/s" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } },
        "overrides": [
          { "matcher": {"id":"byName","options":"Rollbacks/s"}, "properties": [{"id":"color","value":{"fixedColor":"red","mode":"fixed"}}] }
        ]
      }
    },
    {
      "id": 12, "title": "HikariCP — Active vs Idle vs Pending",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        { "expr": "hikaricp_connections_active",  "legendFormat": "Active" },
        { "expr": "hikaricp_connections_idle",    "legendFormat": "Idle" },
        { "expr": "hikaricp_connections_pending", "legendFormat": "Pending" },
        { "expr": "hikaricp_connections_max",     "legendFormat": "Pool Max" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 8 } },
        "overrides": [
          { "matcher": {"id":"byName","options":"Pool Max"}, "properties": [{"id":"custom.lineStyle","value":{"fill":"dash","dash":[8,4]}},{"id":"color","value":{"fixedColor":"red","mode":"fixed"}}] }
        ]
      }
    },

    {
      "id": 20, "type": "row", "title": "REDIS",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 }, "collapsed": false
    },
    {
      "id": 21, "title": "Redis UP",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 0, "y": 22 },
      "targets": [{ "expr": "redis_up", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "name", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": { "defaults": { "mappings": [{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}], "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"green","value":1}] } } }
    },
    {
      "id": 22, "title": "Memory Used",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 4, "y": 22 },
      "targets": [{ "expr": "redis_memory_used_bytes", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [{"color":"blue","value":null}] } } }
    },
    {
      "id": 23, "title": "Commands/sec",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 8, "y": 22 },
      "targets": [{ "expr": "rate(redis_commands_processed_total[1m])", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"color":"blue","value":null}] } } }
    },
    {
      "id": 24, "title": "Connected Clients",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 12, "y": 22 },
      "targets": [{ "expr": "redis_connected_clients", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":50},{"color":"red","value":100}] } } }
    },
    {
      "id": 25, "title": "Cache Hit Rate",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 16, "y": 22 },
      "targets": [{ "expr": "(rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))) * 100", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"yellow","value":60},{"color":"green","value":80}] } } }
    },
    {
      "id": 26, "title": "Evictions",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 20, "y": 22 },
      "targets": [{ "expr": "rate(redis_evicted_keys_total[5m])", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":10}] } } }
    },
    {
      "id": 30, "title": "Redis Memory & Connections",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "targets": [
        { "expr": "redis_memory_used_bytes",        "legendFormat": "Memory Used" },
        { "expr": "redis_memory_max_bytes",          "legendFormat": "Memory Max" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } },
        "overrides": [
          { "matcher": {"id":"byName","options":"Memory Max"}, "properties": [{"id":"custom.lineStyle","value":{"fill":"dash","dash":[8,4]}},{"id":"color","value":{"fixedColor":"red","mode":"fixed"}}] }
        ]
      }
    },
    {
      "id": 31, "title": "Redis Hit vs Miss",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "targets": [
        { "expr": "rate(redis_keyspace_hits_total[5m])",   "legendFormat": "Hits/s" },
        { "expr": "rate(redis_keyspace_misses_total[5m])", "legendFormat": "Misses/s" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } },
        "overrides": [
          { "matcher": {"id":"byName","options":"Misses/s"}, "properties": [{"id":"color","value":{"fixedColor":"orange","mode":"fixed"}}] }
        ]
      }
    }
  ]
}
