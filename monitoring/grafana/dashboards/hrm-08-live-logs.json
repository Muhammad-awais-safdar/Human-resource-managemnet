{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "title": "HRM — Live Logs",
  "uid": "hrm-live-logs",
  "tags": ["hrm", "logs", "live", "application"],
  "description": "Live application log stream. Shows ONLY application events — business requests, exceptions, errors, warnings. SQL queries and health probes are silenced.",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 4,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },

  "links": [
    { "title": "📊 Overview",        "url": "/d/hrm-overview",       "type": "link", "icon": "home", "targetBlank": false },
    { "title": "⚡ Error Center",    "url": "/d/hrm-error-center",   "type": "link", "icon": "bug", "targetBlank": false },
    { "title": "🚀 API Performance", "url": "/d/hrm-api",            "type": "link", "icon": "trending-up", "targetBlank": false },
    { "title": "☕ Application",     "url": "/d/hrm-application",    "type": "link", "icon": "bolt", "targetBlank": false },
    { "title": "🔥 Troubleshoot",    "url": "/d/hrm-troubleshoot",   "type": "link", "icon": "fire", "targetBlank": false }
  ],

  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "current": { "text": "ALL", "value": "ALL" },
        "options": [
          { "selected": true,  "text": "ALL",   "value": "ALL"   },
          { "selected": false, "text": "INFO",  "value": "INFO"  },
          { "selected": false, "text": "WARN",  "value": "WARN"  },
          { "selected": false, "text": "ERROR", "value": "ERROR" }
        ],
        "query": "ALL,INFO,WARN,ERROR",
        "includeAll": false
      },
      {
        "name": "search",
        "label": "Search Log Message",
        "type": "textbox",
        "current": { "text": "", "value": "" },
        "query": ""
      }
    ]
  },

  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "APPLICATION LOG METRICS & STREAM STATUS",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 2,
      "title": "Log Rate (lines/min)",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [{
        "expr": "sum(rate({container=\"awais-hr-backend\"} !~ `(?i)(actuator|/health|/ping|/ready|Hibernate:|select\\s+|insert\\s+|update\\s+|delete\\s+)` [1m]))",
        "legendFormat": "Log Rate"
      }],
      "options": {
        "colorMode": "value", "graphMode": "area", "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0, "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#38bdf8", "value": null }] }
        }
      }
    },
    {
      "id": 3,
      "title": "ERRORs & Exceptions (5m)",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [{
        "expr": "sum(count_over_time({container=\"awais-hr-backend\", level=\"ERROR\"} !~ `(?i)(actuator|/health|/ping)` [5m]))",
        "legendFormat": "Errors"
      }],
      "options": {
        "colorMode": "value", "graphMode": "area", "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0, "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "#4ade80", "value": null },
            { "color": "#fbbf24", "value": 1 },
            { "color": "#f87171", "value": 5 }
          ]}
        }
      }
    },
    {
      "id": 4,
      "title": "WARNs (last 5m)",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [{
        "expr": "sum(count_over_time({container=\"awais-hr-backend\", level=\"WARN\"} !~ `(?i)(actuator|/health|/ping)` [5m]))",
        "legendFormat": "Warnings"
      }],
      "options": {
        "colorMode": "value", "graphMode": "area", "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0, "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "#4ade80", "value": null },
            { "color": "#fbbf24", "value": 1 },
            { "color": "#fb923c", "value": 10 }
          ]}
        }
      }
    },
    {
      "id": 5,
      "title": "Log Volume by Level (30m)",
      "type": "timeseries",
      "gridPos": { "h": 3, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [
        {
          "expr": "sum(rate({container=\"awais-hr-backend\", level=\"ERROR\"} !~ `(?i)(actuator|/health|/ping)` [2m]))",
          "legendFormat": "ERROR"
        },
        {
          "expr": "sum(rate({container=\"awais-hr-backend\", level=\"WARN\"} !~ `(?i)(actuator|/health|/ping)` [2m]))",
          "legendFormat": "WARN"
        },
        {
          "expr": "sum(rate({container=\"awais-hr-backend\", level=\"INFO\"} !~ `(?i)(actuator|/health|/ping|Hibernate:|select\\s+|insert\\s+|update\\s+|delete\\s+)` [2m]))",
          "legendFormat": "INFO"
        }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 0, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ERROR" }, "properties": [{ "id": "color", "value": { "fixedColor": "#ef4444", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "WARN"  }, "properties": [{ "id": "color", "value": { "fixedColor": "#f97316", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "INFO"  }, "properties": [{ "id": "color", "value": { "fixedColor": "#3b82f6", "mode": "fixed" } }] }
        ]
      }
    },

    {
      "id": 10,
      "type": "row",
      "title": "● LIVE APPLICATION LOG STREAM — Clean Business Events & Exceptions Only",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "Live Application Logs & Exceptions",
      "description": "Real-time application event stream. Shows API requests, status codes, warnings, and uncaught exception stack traces. SQL query noise and actuator probes are filtered out.",
      "type": "logs",
      "gridPos": { "h": 22, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [
        {
          "expr": "{container=\"awais-hr-backend\"} !~ `(?i)(actuator/health|actuator/prometheus|/api/v1/actuator|/health\\b|/ping\\b|/ready\\b|/liveness\\b|/readiness\\b|Hibernate:|select\\s+ou|select\\s+te|select\\s+t1|insert\\s+into|update\\s+|delete\\s+from)` |= `${search:raw}`",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}
