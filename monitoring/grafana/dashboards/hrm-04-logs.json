{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "title": "HRM \u2014 Logs",
  "uid": "hrm-logs",
  "tags": ["hrm", "logs", "loki"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "links": [{ "title": "Overview", "url": "/d/hrm-overview", "type": "link" }],

  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "current": { "text": "All", "value": "" },
        "options": [
          {"text":"All","value":""},
          {"text":"backend","value":"backend"},
          {"text":"frontend","value":"frontend"},
          {"text":"db","value":"db"},
          {"text":"redis","value":"redis"}
        ],
        "query": ",backend,frontend,db,redis",
        "includeAll": true, "allValue": ""
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "current": { "text": "All", "value": "" },
        "options": [
          {"text":"All","value":""},
          {"text":"ERROR","value":"ERROR"},
          {"text":"WARN","value":"WARN"},
          {"text":"INFO","value":"INFO"}
        ],
        "query": ",ERROR,WARN,INFO",
        "includeAll": true, "allValue": ""
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "current": { "text": "", "value": "" },
        "query": ""
      }
    ]
  },

  "panels": [
    {
      "id": 1, "type": "row", "title": "LOG VOLUME",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false
    },
    {
      "id": 2, "title": "Log Rate by Level",
      "type": "timeseries", "gridPos": { "h": 7, "w": 16, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [
        { "expr": "sum(rate({container=\"awais-hr-backend\", level=\"ERROR\"}[2m]))", "legendFormat": "ERROR" },
        { "expr": "sum(rate({container=\"awais-hr-backend\", level=\"WARN\"}[2m]))",  "legendFormat": "WARN" },
        { "expr": "sum(rate({container=\"awais-hr-backend\", level=\"INFO\"}[2m]))",  "legendFormat": "INFO" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 70 } },
        "overrides": [
          { "matcher": {"id":"byName","options":"ERROR"}, "properties": [{"id":"color","value":{"fixedColor":"red","mode":"fixed"}}] },
          { "matcher": {"id":"byName","options":"WARN"},  "properties": [{"id":"color","value":{"fixedColor":"orange","mode":"fixed"}}] },
          { "matcher": {"id":"byName","options":"INFO"},  "properties": [{"id":"color","value":{"fixedColor":"blue","mode":"fixed"}}] }
        ]
      }
    },
    {
      "id": 3, "title": "Total Logs (Last 30m)",
      "type": "stat", "gridPos": { "h": 3, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [{ "expr": "sum(count_over_time({container=\"awais-hr-backend\"}[30m]))", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"color":"blue","value":null}] } } }
    },
    {
      "id": 4, "title": "Error Count (Last 30m)",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 16, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [{ "expr": "sum(count_over_time({container=\"awais-hr-backend\", level=\"ERROR\"}[30m]))", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":10}] } } }
    },

    {
      "id": 10, "type": "row", "title": "LIVE LOGS",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 }, "collapsed": false
    },
    {
      "id": 11, "title": "\ud83d\udd34 ERRORS",
      "type": "logs", "gridPos": { "h": 10, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [{ "expr": "{container=\"awais-hr-backend\", level=\"ERROR\"}", "legendFormat": "" }],
      "options": {
        "showTime": true, "showLabels": false, "showCommonLabels": true,
        "wrapLogMessage": true, "prettifyLogMessage": false,
        "enableLogDetails": true, "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 12, "title": "\u26a0\ufe0f WARNINGS",
      "type": "logs", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [{ "expr": "{container=\"awais-hr-backend\", level=\"WARN\"}", "legendFormat": "" }],
      "options": {
        "showTime": true, "showLabels": false, "showCommonLabels": true,
        "wrapLogMessage": true, "prettifyLogMessage": false,
        "enableLogDetails": true, "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },

    {
      "id": 20, "type": "row", "title": "ALL CONTAINERS",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }, "collapsed": false
    },
    {
      "id": 21, "title": "All Service Logs",
      "type": "logs", "gridPos": { "h": 12, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [{ "expr": "{container=~\"awais-hr-.*\"}", "legendFormat": "" }],
      "options": {
        "showTime": true, "showLabels": true, "showCommonLabels": false,
        "wrapLogMessage": true, "prettifyLogMessage": false,
        "enableLogDetails": true, "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}
