  "links": [
    { "title": "🔴 Live Logs",       "url": "/d/hrm-live-logs",      "type": "link", "icon": "search", "targetBlank": false },
    { "title": "⚡ Error Center",    "url": "/d/hrm-error-center",   "type": "link", "icon": "bug", "targetBlank": false },
    { "title": "📊 Production Overview","url":"/d/hrm-overview",     "type": "link", "icon": "home", "targetBlank": false },
    { "title": "🚀 API Performance", "url": "/d/hrm-api",            "type": "link", "icon": "trending-up", "targetBlank": false },
