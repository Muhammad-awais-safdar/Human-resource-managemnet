  ],

  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "<div style=\"background: linear-gradient(90deg, #1e293b 0%, #0f172a 100%); padding: 16px 24px; border-radius: 8px; border: 1px solid #334155;\"><h2 style=\"margin:0; color:#f8fafc; font-weight:700;\">🛡️ Awais HR Enterprise — Observability Portal</h2><p style=\"margin:4px 0 0 0; color:#94a3b8; font-size:14px;\">Production telemetry, distributed tracing (Tempo), structured JSON logs (Loki), and metric monitoring (Prometheus).</p></div>"
      }
    },

    {
      "id": 2,
      "title": "Backend Service",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 3 },
      "targets": [{ "expr": "up{job=\"awais-hr-backend\"}", "legendFormat": "Backend" }],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "noValue": "DOWN",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 3,
      "title": "PostgreSQL DB",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 3 },
      "targets": [{ "expr": "pg_up", "legendFormat": "Database" }],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "noValue": "DOWN",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 4,
      "title": "Redis Cache",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 3 },
      "targets": [{ "expr": "redis_up", "legendFormat": "Redis" }],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "noValue": "DOWN",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 5,
      "title": "5xx Error Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 3 },
      "targets": [{ "expr": "((sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) or vector(0)) / (sum(rate(http_server_requests_seconds_count[5m])) or vector(1))) * 100", "legendFormat": "" }],
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "noValue": "0.00%", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } }
    },
    {
      "id": 6,
      "title": "P95 Latency",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 3 },
      "targets": [{ "expr": "(histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le)) * 1000) or vector(0)", "legendFormat": "" }],
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 1, "noValue": "0.0 ms", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 300 }, { "color": "red", "value": 1000 }] } } }
    },
    {
      "id": 7,
      "title": "JVM Heap Used",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 3 },
      "targets": [{ "expr": "((sum(jvm_memory_used_bytes{area=\"heap\"}) / sum(jvm_memory_max_bytes{area=\"heap\"})) * 100) or vector(0)", "legendFormat": "" }],
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "noValue": "0.0%", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 88 }] } } }
    },
    {
      "id": 8,
      "title": "App Errors (5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 3 },
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [{ "expr": "sum(count_over_time({container=\"awais-hr-backend\", level=\"ERROR\"} !~ `(?i)(actuator|/health|/ping)` [5m]))", "legendFormat": "" }],
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "0", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } }
    },
    {
      "id": 9,
      "title": "Host CPU Load",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 3 },
      "targets": [{ "expr": "(100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)) or vector(0)", "legendFormat": "" }],
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "noValue": "0.0%", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 88 }] } } }
    },

    {
      "id": 10,
      "type": "row",
      "title": "OBSERVABILITY PORTALS",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
