{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "07 - Multi-Tenant Operations & Resource Usage",
  "uid": "awais-hr-tenant-07",
  "tags": ["tenant", "multi-tenant", "analytics", "operations"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Per-Tenant Request Traffic (Req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (tenantId)",
          "legendFormat": "Tenant: {{ tenantId }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } }
    },
    {
      "id": 2,
      "title": "Per-Tenant API Errors (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) by (tenantId)",
          "legendFormat": "Tenant: {{ tenantId }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } }
    },
    {
      "id": 3,
      "title": "Per-Tenant Active Users & Provisioned Seats",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "hr_employees_total",
          "legendFormat": "Tenant Seats"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } }
    },
    {
      "id": 4,
      "title": "Per-Tenant Storage Usage (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "hr_storage_usage_mb",
          "legendFormat": "Tenant Storage (MB)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "decbytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } }
    }
  ]
}
